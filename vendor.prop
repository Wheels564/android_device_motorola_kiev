# Audio
persist.vendor.audio.calfile0=/vendor/etc/acdbdata/Bluetooth_cal.acdb
persist.vendor.audio.calfile1=/vendor/etc/acdbdata/General_cal.acdb
persist.vendor.audio.calfile2=/vendor/etc/acdbdata/Global_cal.acdb
persist.vendor.audio.calfile3=/vendor/etc/acdbdata/Handset_cal.acdb
persist.vendor.audio.calfile4=/vendor/etc/acdbdata/Hdmi_cal.acdb
persist.vendor.audio.calfile5=/vendor/etc/acdbdata/Headset_cal.acdb
persist.vendor.audio.calfile6=/vendor/etc/acdbdata/Speaker_cal.acdb
ro.hardware.audio.primary=lito-moto

# Bluetooth
bluetooth.device.default_name=moto g 5G

# Camera
persist.vendor.camera.physical.num=4
persist.vendor.camera.privapp.list=com.motorola.camera3

# Chipset
ro.soc.manufacturer=QTI
ro.soc.model=SM7225

# Firmware
ro.vendor.hw.modem_version=.

# FM
ro.vendor.fm.use_audio_session=true

# Graphics
persist.sys.sf.color_mode=0

# HDR
ro.vendor.display.hdr.config=/vendor/etc/hdr_tm_config.xml

# Media
media.stagefright.enable-player=true
media.stagefright.enable-http=true
media.stagefright.enable-aac=true
media.stagefright.enable-qcp=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-scan=true
media.recorder.show_manufacturer_and_model=true
vendor.mm.en.sec.smoothstreaming=false

# Sensors
persist.vendor.sensors.allow_non_default_discovery=true
persist.vendor.sensors.hal_trigger_ssr=false
persist.vendor.sensors.odl.adsp=true
ro.vendor.hw.thermal_skin_val=battery
ro.vendor.sensors.glance_approach=false
ro.vendor.sensors.mot_ltv=true

# IMS/VoWiFi Configuration for US Mobile Warp (MCC 311 / MNC 480)

# Enable IMS Stack
persist.sys.ims.registration=1
persist.sys.ims.allow_roaming=true
persist.sys.ims.prefer_ims=true

# VoWiFi/WiFi Calling
persist.radio.vowifi=1
persist.radio.vowifi_mode_user_set=1
persist.radio.vowifi_mode_user_pref=2
persist.sys.wfc_mode=2
persist.vendor.wfc.feature_enabled=1

# IMS Domain
persist.sys.ims.domain=ims.uscc.net

# E911 Address Provisioning
persist.vendor.ims.e911_provisioned=0

# APN Configuration
persist.radio.apn_sel_by_default=1
persist.vendor.apn.use_static_config=1

# Enhanced Calling Features
persist.radio.ims_enabled=1
persist.radio.volte=1
persist.radio.vt=1
